# Decrity Environment Variables
# Copy this file to .env and fill in your actual values

# API Configuration
API_PORT=3000
API_HOST=localhost
NODE_ENV=development

# Database (PostgreSQL)
POSTGRES_PASSWORD="change-me-in-production"
DATABASE_URL="postgresql://decrity:change-me-in-production@localhost:5432/decrity?schema=public"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="your-secret-key-here-change-in-production"
JWT_EXPIRES_IN="7d"

# ML Service
ML_SERVICE_URL="http://localhost:8000"

# Extension API Endpoint (no /v1 suffix, API_ENDPOINTS constants already include it)
VITE_API_URL="http://localhost:3000"

# Dashboard API Endpoint (no /v1 suffix, API_ENDPOINTS constants already include it)
VITE_DASHBOARD_API_URL="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60000

# Monitoring (optional)
SENTRY_DSN=""
POSTHOG_API_KEY=""

# Cloud Deployment (production only)
# RAILWAY_API_URL=""
# MODAL_API_KEY=""
