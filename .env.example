# Decrity Environment Variables
# Copy this file to .env and fill in your actual values

# API Configuration
API_PORT=3000
API_HOST=localhost
NODE_ENV=development

# Database (PostgreSQL)
POSTGRES_PASSWORD="change-me-in-production"
DATABASE_URL="postgresql://decrity:change-me-in-production@localhost:5432/decrity?schema=public"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="your-secret-key-here-change-in-production"
JWT_EXPIRES_IN="7d"

# ML Service
ML_SERVICE_URL="http://localhost:8000"

# Layer 2 semantic classification (packages/ml-service/app/classifier.py).
# Routed through LiteLLM, so OPENROUTER_API_KEY works with any OpenRouter
# model. Get a key at https://openrouter.ai/keys. Leave unset to run on
# Layer 1 heuristics only (fails open, no error) -- useful for local dev
# without incurring any API cost.
OPENROUTER_API_KEY=""
# Defaults to a specific free model rather than OpenRouter's rotating
# "free" router, since the router proved unpredictable in testing (it can
# land on a model with weak JSON-instruction-following). Override to pin a
# different or paid model, e.g. "openrouter/anthropic/claude-3-5-haiku".
CLASSIFIER_MODEL="openrouter/baidu/ernie-5.5-flash-preview:free"

# Extension API Endpoint (no /v1 suffix, API_ENDPOINTS constants already include it)
VITE_API_URL="http://localhost:3000"

# Dashboard API Endpoint (no /v1 suffix, API_ENDPOINTS constants already include it)
VITE_DASHBOARD_API_URL="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60000

# Monitoring (optional)
SENTRY_DSN=""
POSTHOG_API_KEY=""

# Cloud Deployment (production only)
# RAILWAY_API_URL=""
# MODAL_API_KEY=""
