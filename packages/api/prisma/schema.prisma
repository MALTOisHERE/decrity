// Prisma schema for Decrity

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev on Windows/Mac/glibc-Linux. The musl target
  // is needed for the Alpine-based Docker image (packages/api/Dockerfile);
  // without it Prisma generates an openssl-1.1 engine binary that crashes
  // at runtime ("Error loading shared library libssl.so.1.1"), since
  // modern Alpine (node:20-alpine) ships OpenSSL 3.x only, found 2026-11-07
  // the first time the API ran in its own container.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptionTier   String  @default("free") // free | premium
  subscriptionStatus String? // active | cancelled | expired | trial

  // Settings (JSON)
  settings Json @default("{\"protectionEnabled\": true, \"privacyMode\": true, \"notificationsEnabled\": true, \"alertLevel\": \"suspicious-and-threat\", \"supportedPlatforms\": {\"chatgpt\": true, \"gemini\": true, \"claude\": true, \"copilot\": true}}")

  // Relations
  scans ScanResult[]

  @@index([email])
}

model ScanResult {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Content hash (not the actual content!)
  contentHash String

  // Scan result
  verdict         String // clean | suspicious | threat
  score           Float // 0-1
  reason          String?
  detectionLayer  String // heuristic | ml | both

  // Platform
  platform String // chatgpt | gemini | claude | copilot

  // User (optional, for logged-in users)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([contentHash])
  @@index([createdAt])
}

model GapReport {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // No content, no selector text: platform id, timestamp, extension version only
  // (.wayfinder/tickets/003-gap-report-contract.md). 30-day retention per
  // .wayfinder/tickets/004-privacy-policy-disclosure.md; not enforced by any
  // cleanup job yet, matching ScanResult's RETENTION constants today.
  platform         String // chatgpt | gemini | claude | copilot
  reportedAt       DateTime // client-supplied timestamp of the gap detection
  extensionVersion String

  @@index([platform, createdAt])
}

model WaitlistSignup {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
